# Copy to .env.deploy and fill in. .env.* is gitignored — never commit a real key.
#
#   set -a; . ./.env.deploy; set +a; npm run deploy:ledge
#
# Base Sepolia: https://sepolia.base.org   (chainId 84532, faucet ETH)
# Base mainnet: https://mainnet.base.org   (chainId 8453,  real ETH)
LEDGE_RPC_URL=https://sepolia.base.org

# Deployer private key, 0x-prefixed. Use a throwaway key that holds only gas.
LEDGE_DEPLOYER_KEY=

# Safety latch: must equal the target chain id before anything is broadcast.
# Leave unset for a dry run (compile + simulate + cost estimate, nothing sent).
# LEDGE_CONFIRM=84532
